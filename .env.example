# Copy to .env for local overrides (never commit .env).
# Production / docker: set these in the host environment.

# Required in production (Rails signing + cookies).
SECRET_KEY_BASE=

# Required in production (PostgreSQL). Example:
# DATABASE_URL=postgres://user:pass@localhost:5432/acme_salary_production
DATABASE_URL=

# Optional
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info
